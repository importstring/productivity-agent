{
  "system": {
    "name": "ProductivityAgent",
    "version": "1.0.0",
    "log_level": "INFO",
    "data_dir": "data",
    "log_dir": "logs"
  },
  "recording": {
    "camera": {
      "device_id": 0,
      "frame_width": 640,
      "frame_height": 480,
      "fps": 30
    },
    "audio": {
      "sample_rate": 44100,
      "channels": 1,
      "chunk_size": 1024
    },
    "storage": {
      "video_format": "mp4",
      "audio_format": "wav",
      "recordings_dir": "data/recordings",
      "responses_dir": "data/responses"
    }
  },
  "agents": {
    "product_manager": {
      "model": "llama2:7b",
      "meeting_time": "07:30"
    },
    "research": {
      "model": "llama2:250m",
      "topics_per_cycle": 3
    },
    "insights": {
      "model": "llama2:250m",
      "analysis_interval": 300
    }
  },
  "processing": {
    "daily_cycle_interval": 86400,
    "overnight_processing_time": "00:00",
    "max_processing_time": 3600
  },
  "storage": {
    "type": "file",
    "path": "data",
    "backup_interval": 3600
  },
  "logging": {
    "level": "INFO",
    "file": "logs/productivity_agent.log"
  }
}
